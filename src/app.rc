// GenryTB: the icon of the program (and of its window: Qt picks IDI_ICON1 up) and what Windows shows in its Properties
#include <winver.h>

IDI_ICON1 ICON "../data/genrytb.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "GenryTheFox"
            VALUE "FileDescription", "GenryTB - Tiny Bunny mod maker"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "GenryTB"
            VALUE "LegalCopyright", "GenryTheFox"
            VALUE "OriginalFilename", "GenryTB.exe"
            VALUE "ProductName", "GenryTB"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
